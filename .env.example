# Database
DATABASE_URL="postgresql://username:password@localhost:5432/wepay_db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="WePay"

# Mobile app authentication (required for the Android app)
# Generate with: openssl rand -base64 48
MOBILE_JWT_SECRET="replace-with-at-least-32-random-characters"

# Email delivery for password-reset codes (optional; without it the mobile
# "Forgot password" screen tells users to contact support in production)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="WePay <no-reply@your-domain.com>"
